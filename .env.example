# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.mamallaresort.com

# ---- Booking engine (optional) ----
# The resort's existing booking-engine URL. Leave blank until confirmed with the provider.
# When blank, "Check availability" opens the on-site reservation request (/book).
NEXT_PUBLIC_BOOKING_ENGINE_URL=
# Only set these if the booking provider documents deep-link parameters.
# Each value is the provider's query-parameter name; leave blank to omit that value.
NEXT_PUBLIC_BOOKING_PARAM_CHECKIN=
NEXT_PUBLIC_BOOKING_PARAM_CHECKOUT=
NEXT_PUBLIC_BOOKING_PARAM_ADULTS=
NEXT_PUBLIC_BOOKING_PARAM_CHILDREN=
NEXT_PUBLIC_BOOKING_PARAM_ROOMS=
# Date format the provider expects: "yyyy-mm-dd" (default) or "dd/mm/yyyy" or "dd-mm-yyyy"
NEXT_PUBLIC_BOOKING_DATE_FORMAT=yyyy-mm-dd

# ---- 360° virtual tour (optional) ----
# The embeddable URL of the resort's existing 360° tour (must allow iframe embedding).
NEXT_PUBLIC_VIRTUAL_TOUR_URL=

# ---- Enquiry delivery (configure at least one) ----
# Option A: Resend (https://resend.com) — transactional email
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=
# Option B: Any HTTPS webhook (Zapier, Make, Formspree, CRM endpoint). Receives JSON.
ENQUIRY_WEBHOOK_URL=
